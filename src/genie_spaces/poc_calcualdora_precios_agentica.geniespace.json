  "instructions": {
    "example_question_sqls": [
      {
        "id": "01f186df9bd11847b4fcbc9eeffb7888",
        "question": [
          "Cual es el descuento promedio  en lempiras por saco, que tengo en el producto cemento UG en la zona Distrito central?"
        ],
        "sql": [
          "SELECT\r\n",
          "  `ZONA`,\r\n",
          "  `Texto_material`,\r\n",
          "  AVG(`DESCUENTO`) AS descuento_promedio,\r\n",
          "  COUNT(*) AS num_registros,\r\n",
          "  SUM(`VALOR_BRUTO`) AS valor_bruto_total,\r\n",
          "  SUM(`VALOR_NETO`) AS valor_neto_total\r\n",
          "FROM\r\n",
          "  `slv_dev`.`star_generico`.`tabla_descuentos`\r\n",
          "WHERE\r\n",
          "  `ZONA` ILIKE '%DISTRITO CENTRAL%'\r\n",
          "  AND `Nombre_material` ILIKE '%GU BOLSA%'\r\n",
          "  AND `DESCUENTO` IS NOT NULL\r\n",
          "GROUP BY\r\n",
          "  `ZONA`,\r\n",
          "  `Texto_material`"
        ]
      }
    ],
    "text_instructions": [
      {
        "content": [
          "Cuando traiga una pregunta para la columna de Descuento, debe dar el valor absoluto en lempiras, y el valor porcentual respecto al precio bruto.\r\n",
          "Para la fuente de chequeo de precios, traer la columna de Fecha de Visita"
        ],
        "id": "01f186ec6c3e13769042f0f94db46e76"
      }
    ]
  },
  "version": 2
